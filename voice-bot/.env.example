# ── שרת הגשר הקולי (voice-bot) ──
# העתק לקובץ .env ומלא את הערכים. אל תעשה commit ל-.env !

# מפתח OpenAI (רגיל - כולל גישה ל-Realtime API)
OPENAI_API_KEY=sk-...

# מודל ה-Realtime (ברירת מחדל gpt-realtime)
OPENAI_REALTIME_MODEL=gpt-realtime

# כתובת ה-CRM (Railway) - בלי / בסוף
CRM_BASE_URL=https://your-crm.up.railway.app

# מפתח ה-API הייעודי לבוט - חייב להיות זהה ל-VOICE_API_KEY שב-CRM
VOICE_API_KEY=change-me-to-a-long-random-string

# הדומיין הציבורי של שרת הגשר עצמו (בלי https://) - עבור ה-TwiML WebSocket
# בפיתוח מקומי עם ngrok: xxxx.ngrok-free.app
PUBLIC_HOST=voice-bot-production.up.railway.app

# פורט (Railway מזריק PORT אוטומטית)
PORT=5050

# ── Twilio REST API (לשליחת סיכומי שיחה והתראות מגייס יזומות בוואטסאפ) ──
# מוצאים ב-Twilio Console → Account → API keys & tokens
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# מספר הוואטסאפ ה"שולח" (מספר הבוט עצמו, כפי שמוגדר ב-Twilio)
TWILIO_WHATSAPP_FROM=whatsapp:+97233822232

# מספר הוואטסאפ של בעל המערכת/המגייס - לשם יישלחו סיכומי שיחה והתראות
OWNER_WHATSAPP_TO=whatsapp:+972545478667
